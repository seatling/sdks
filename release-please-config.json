{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "seatling-sdks",
      "include-component-in-tag": false,
      "pull-request-title-pattern": "chore: release ${version}",
      "extra-files": [
        "package.json",
        "crates/seatling-node/package.json",
        {
          "type": "toml",
          "path": "crates/seatling/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/seatling-node/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
